# Development-only example values.
# Copy this file to .env and replace all secrets before any shared deployment.

DB_USER=hotel_app
DB_PASSWORD=change-me-local-only
DB_NAME=hotel_pms_dev
DATABASE_URL=postgresql://hotel_app:change-me-local-only@postgres_db:5432/hotel_pms_dev?schema=public

JWT_SECRET=replace-with-a-long-random-secret
METRICS_TOKEN=replace-with-a-separate-random-token
CORS_ORIGINS=http://localhost:5173

BACKEND_PORT=3000
FRONTEND_PORT=5173
